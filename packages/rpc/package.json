{
  "name": "@repo/rpc",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "eval:protototo": "node scripts/check-protototo-eval.mjs",
    "eval:documents": "node -r ts-node/register -r tsconfig-paths/register scripts/check-documents-media-eval.mjs",
    "migration:run": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:revert",
    "auth:create-user": "ts-node -r tsconfig-paths/register src/admin/create-user.ts",
    "auth:create-api-key": "ts-node -r tsconfig-paths/register src/admin/create-api-key.ts",
    "eval": "node ../../scripts/check-cqrs-boundary.mjs && node ../../scripts/check-season-model-contract.mjs && node ../../scripts/check-user-information-contract.mjs && node ../../scripts/check-database-hygiene-contract.mjs"
  },
  "exports": {
    "./router": {
      "types": "./src/router.ts",
      "default": "./src/router.ts"
    }
  },
  "dependencies": {
    "@better-auth/api-key": "^1.6.23",
    "@nestjs/common": "^11.1.11",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.11",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/typeorm": "^11.0.0",
    "@repo/api": "workspace:*",
    "@trpc/server": "^11.7.2",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.23",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "file-type": "21.3.4",
    "multer": "^2.2.0",
    "oci-common": "^2.136.0",
    "oci-objectstorage": "^2.136.0",
    "oci-sdk": "^2.136.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.34.5",
    "trpc-docs-generator": "^0.9.0",
    "typeorm": "^0.3.28",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.11",
    "@repo/eslint-config": "workspace:*",
    "@repo/jest-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.19.3",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.8.2"
  }
}
